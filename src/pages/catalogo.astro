---
import Layout from '../layouts/Layout.astro';
import CatalogSection from '../components/CatalogSection.vue';
---

<Layout title="Catálogo de Decants | Sir Parfums">
  <div class="bg-neutral-950 font-sans text-neutral-100 antialiased selection:bg-orange-500 selection:text-neutral-950 min-h-screen">
    <section class="mx-auto max-w-7xl px-4 pt-10 pb-8 text-center sm:px-6 sm:text-left lg:px-8">
      <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
        Catálogo de <span class="text-orange-500">Decants</span>
      </h1>
      <!-- <p class="mt-3 max-w-xl text-sm leading-relaxed text-neutral-300 sm:text-base">
        fragancias 100% originales preparadas directamente del frasco base.
      </p> -->
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-6 sm:px-6 lg:px-8">
      <CatalogSection client:load />
    </section>
  </div>
</Layout>
